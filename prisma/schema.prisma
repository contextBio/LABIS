generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LabRole {
  PI
  LAB_MANAGER
  MEMBER
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  name            String
  image           String?
  passwordHash    String?           @map("password_hash")
  username        String?           @unique // c1 서버 리눅스 계정명 (MUSE 공동 로그인용)
  isDeptAdmin     Boolean           @default(false) @map("is_dept_admin")
  // 인사 프로필
  position        String            @default("연구원")
  phone           String            @default("")
  hireDate        String            @default("") @map("hire_date")
  workStatus      String            @default("재직") @map("work_status")
  createdAt       DateTime          @default(now()) @map("created_at")
  memberships     Membership[]
  invitesSent     Invitation[]      @relation("InvitedBy")
  auditLogs       AuditLog[]
  piProjects      Project[]         @relation("ProjectPI")
  projectMembers  ProjectMember[]
  ledResearch     ResearchProject[] @relation("ResearchLeader")
  menuPermissions MenuPermission[]
  samples         Sample[]
  experiments     Experiment[]
  instruments     Instrument[]
  leaves          Leave[]
  purchases       Purchase[]

  @@map("users")
}

model Lab {
  id               Int               @id @default(autoincrement())
  name             String            @unique
  piName           String            @default("") @map("pi_name")
  room             String            @default("")
  status           String            @default("운영")
  createdAt        DateTime          @default(now()) @map("created_at")
  memberships      Membership[]
  invitations      Invitation[]
  auditLogs        AuditLog[]
  settings         Setting[]
  projects         Project[]
  researchProjects ResearchProject[]
  menuPermissions  MenuPermission[]
  samples          Sample[]
  experiments      Experiment[]
  instruments      Instrument[]
  leaves           Leave[]
  publications     Publication[]
  patents          Patent[]
  techTransfers    TechTransfer[]
  purchases        Purchase[]
  fundIncomes      FundIncome[]

  @@map("labs")
}

model Membership {
  id       Int      @id @default(autoincrement())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String   @map("user_id")
  lab      Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  labId    Int      @map("lab_id")
  role     LabRole  @default(MEMBER)
  joinedAt DateTime @default(now()) @map("joined_at")

  @@unique([userId, labId])
  @@map("memberships")
}

model Invitation {
  id          Int       @id @default(autoincrement())
  email       String
  lab         Lab       @relation(fields: [labId], references: [id], onDelete: Cascade)
  labId       Int       @map("lab_id")
  role        LabRole   @default(MEMBER)
  token       String    @unique @default(cuid())
  invitedBy   User?     @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedById String?   @map("invited_by_id")
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("invitations")
}

model AuditLog {
  id       Int      @id @default(autoincrement())
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId   String?  @map("user_id")
  lab      Lab?     @relation(fields: [labId], references: [id], onDelete: SetNull)
  labId    Int?     @map("lab_id")
  action   String
  entity   String
  entityId String   @default("") @map("entity_id")
  detail   Json?
  at       DateTime @default(now())

  @@index([labId, at])
  @@map("audit_logs")
}

// ---------- 도메인: 과제관리 ----------
// 날짜는 UI(date input)와 시트 연동에 맞춰 'YYYY-MM-DD' 문자열로 저장한다.

model Project {
  id               Int               @id @default(autoincrement())
  lab              Lab               @relation(fields: [labId], references: [id], onDelete: Cascade)
  labId            Int               @map("lab_id")
  code             String
  title            String
  sponsor          String            @default("")
  program          String            @default("")
  pi               User?             @relation("ProjectPI", fields: [piId], references: [id], onDelete: SetNull)
  piId             String?           @map("pi_id")
  startDate        String            @default("") @map("start_date")
  endDate          String            @default("") @map("end_date")
  totalBudget      Int               @default(0) @map("total_budget")
  status           String            @default("진행")
  memo             String            @default("")
  createdAt        DateTime          @default(now()) @map("created_at")
  members          ProjectMember[]
  milestones       Milestone[]
  budgetItems      BudgetItem[]
  samples          Sample[]
  experiments      Experiment[]
  publications     Publication[]
  patents          Patent[]
  techTransfers    TechTransfer[]
  purchases        Purchase[]
  fundIncomes      FundIncome[]
  researchProjects ResearchProject[]

  @@unique([labId, code])
  @@map("projects")
}

/// 연구 프로젝트 — 수주 과제(Project)와 별개인 랩 내부의 연구 단위.
/// 과제가 없어도 굴러가고, 있으면 연계만 걸어 둔다.
model ResearchProject {
  id        Int      @id @default(autoincrement())
  lab       Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  labId     Int      @map("lab_id")
  code      String
  title     String
  goal      String   @default("")
  leader    User?    @relation("ResearchLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  leaderId  String?  @map("leader_id")
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId Int?     @map("project_id")
  startDate String   @default("") @map("start_date")
  endDate   String   @default("") @map("end_date")
  status    String   @default("진행")
  memo      String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([labId, code])
  @@map("research_projects")
}

/// 메뉴별 사용자 권한 — 팀관리자(연구책임자)가 조정한다.
/// 행이 없으면 'edit'(기존 역할 규칙 그대로). 역할을 넘어서지는 못하고 있는 권한을
/// 좁히기만 한다: none(차단) < view(읽기 전용) < edit(기존대로).
model MenuPermission {
  id     Int    @id @default(autoincrement())
  lab    Lab    @relation(fields: [labId], references: [id], onDelete: Cascade)
  labId  Int    @map("lab_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")
  menu   String
  level  String @default("edit")

  @@unique([labId, userId, menu])
  @@map("menu_permissions")
}

model ProjectMember {
  id        Int     @id @default(autoincrement())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int     @map("project_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String  @map("user_id")
  role      String  @default("참여연구원")
  effortPct Int     @default(0) @map("effort_pct")

  @@unique([projectId, userId])
  @@map("project_members")
}

model Milestone {
  id        Int     @id @default(autoincrement())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int     @map("project_id")
  title     String
  dueDate   String  @map("due_date")
  status    String  @default("예정")
  memo      String  @default("")

  @@map("milestones")
}

model BudgetItem {
  id        Int     @id @default(autoincrement())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int     @map("project_id")
  category  String  @default("기타")
  item      String
  amount    Int     @default(0)
  spentDate String  @default("") @map("spent_date")
  memo      String  @default("")

  @@map("budget_items")
}

// ---------- 도메인: LIMS ----------

model Sample {
  id              Int          @id @default(autoincrement())
  lab             Lab          @relation(fields: [labId], references: [id], onDelete: Cascade)
  labId           Int          @map("lab_id")
  code            String
  name            String
  type            String       @default("기타")
  source          String       @default("")
  project         Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId       Int?         @map("project_id")
  owner           User?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId         String?      @map("owner_id")
  storageLocation String       @default("") @map("storage_location")
  receivedDate    String       @default("") @map("received_date")
  status          String       @default("보관")
  memo            String       @default("")
  createdAt       DateTime     @default(now()) @map("created_at")
  experiments     Experiment[]

  @@unique([labId, code])
  @@map("samples")
}

model Experiment {
  id            Int      @id @default(autoincrement())
  lab           Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  labId         Int      @map("lab_id")
  code          String
  title         String
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId     Int?     @map("project_id")
  sample        Sample?  @relation(fields: [sampleId], references: [id], onDelete: SetNull)
  sampleId      Int?     @map("sample_id")
  assignee      User?    @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId    String?  @map("assignee_id")
  protocol      String   @default("")
  startDate     String   @default("") @map("start_date")
  endDate       String?  @map("end_date")
  status        String   @default("계획")
  resultSummary String   @default("") @map("result_summary")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([labId, code])
  @@map("experiments")
}

model Instrument {
  id            Int     @id @default(autoincrement())
  lab           Lab     @relation(fields: [labId], references: [id], onDelete: Cascade)
  labId         Int     @map("lab_id")
  name          String
  model         String  @default("")
  serialNo      String  @default("") @map("serial_no")
  manager       User?   @relation(fields: [managerId], references: [id], onDelete: SetNull)
  managerId     String? @map("manager_id")
  location      String  @default("")
  purchaseDate  String? @map("purchase_date")
  lastCheckDate String? @map("last_check_date")
  nextCheckDate String? @map("next_check_date")
  status        String  @default("정상")
  memo          String  @default("")
  shared        Boolean @default(false) // 학과 공용 장비 자리 (추후)

  @@map("instruments")
}

// ---------- 도메인: 성과 (논문 · 특허 · 기술이전) ----------

model Publication {
  id        Int      @id @default(autoincrement())
  lab       Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  labId     Int      @map("lab_id")
  title     String
  journal   String   @default("")
  year      String   @default("")
  authors   String   @default("")
  doi       String   @default("")
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId Int?     @map("project_id")
  memo      String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("publications")
}

model Patent {
  id             Int      @id @default(autoincrement())
  lab            Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  labId          Int      @map("lab_id")
  title          String
  applicationNo  String   @default("") @map("application_no")
  registrationNo String   @default("") @map("registration_no")
  status         String   @default("출원")
  date           String   @default("")
  inventors      String   @default("")
  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId      Int?     @map("project_id")
  memo           String   @default("")

  @@map("patents")
}

model TechTransfer {
  id           Int      @id @default(autoincrement())
  lab          Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  labId        Int      @map("lab_id")
  title        String
  licensee     String   @default("")
  contractDate String   @default("") @map("contract_date")
  amount       Int      @default(0)
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId    Int?     @map("project_id")
  memo         String   @default("")

  @@map("tech_transfers")
}

// ---------- 도메인: 구매 ----------

model Purchase {
  id          Int      @id @default(autoincrement())
  lab         Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  labId       Int      @map("lab_id")
  item        String
  vendor      String   @default("")
  category    String   @default("재료비")
  amount      Int      @default(0)
  orderDate   String   @default("") @map("order_date")
  status      String   @default("신청")
  requester   User?    @relation(fields: [requesterId], references: [id], onDelete: SetNull)
  requesterId String?  @map("requester_id")
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId   Int?     @map("project_id")
  memo        String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("purchases")
}

// ---------- 도메인: 연구비 수입 (수지 분석용) ----------

model FundIncome {
  id        Int      @id @default(autoincrement())
  lab       Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  labId     Int      @map("lab_id")
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId Int?     @map("project_id")
  date      String   @default("")
  amount    Int      @default(0)
  note      String   @default("")

  @@map("fund_incomes")
}

// ---------- 도메인: 인사 (휴가) ----------

model Leave {
  id        Int      @id @default(autoincrement())
  lab       Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  labId     Int      @map("lab_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  type      String   @default("연차")
  startDate String   @map("start_date")
  endDate   String   @map("end_date")
  days      Float    @default(1)
  reason    String   @default("")
  status    String   @default("신청")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("leaves")
}

model Setting {
  id    Int    @id @default(autoincrement())
  scope String @default("dept") // 'dept' | 'lab'
  lab   Lab?   @relation(fields: [labId], references: [id], onDelete: Cascade)
  labId Int?   @map("lab_id")
  key   String
  value String @default("")

  @@unique([scope, labId, key])
  @@map("settings")
}
